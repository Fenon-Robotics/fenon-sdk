{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.fenon.ai/contracts/fenon.hand_pose.video/1.0.0/outputs.schema.json",
  "title": "HandPoseOutputs",
  "description": "The run's outputs object when succeeded, for contract fenon.hand_pose.video 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotations"],
  "properties": {
    "annotations": {
      "title": "AnnotationsFile",
      "type": "object",
      "required": ["content_type", "url", "url_expires_at", "size_bytes"],
      "description": "JSON Lines, one row per processed frame in frame order; each line validates against row.schema.json.",
      "properties": {
        "content_type": { "const": "application/x-ndjson" },
        "url": { "type": "string", "format": "uri", "x-repr": false },
        "url_expires_at": { "type": "string", "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
