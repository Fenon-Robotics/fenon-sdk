{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.fenon.ai/contracts/models/fenon.hand_pose.video/1.1.0/outputs.schema.json",
  "title": "HandPoseOutputs",
  "description": "The run's outputs object when succeeded, for contract fenon.hand_pose.video 1.1.0: always `annotations`, and `video` when the run asked for it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotations"
  ],
  "properties": {
    "annotations": {
      "title": "AnnotationsFile",
      "type": "object",
      "required": [
        "content_type",
        "url",
        "url_expires_at",
        "size_bytes"
      ],
      "description": "JSON Lines, one row per processed frame in frame order; each line validates against row.schema.json.",
      "properties": {
        "content_type": {
          "const": "application/x-ndjson"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "x-repr": false
        },
        "url_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "video": {
      "title": "VideoFile",
      "type": "object",
      "required": [
        "content_type",
        "url",
        "url_expires_at",
        "size_bytes"
      ],
      "description": "The input video with each frame's hands drawn on it, H.264 in fragmented MP4. Frame N of this video is row N of annotations. Needs an input video with an even width and height.",
      "properties": {
        "content_type": {
          "const": "video/mp4"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "x-repr": false
        },
        "url_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
